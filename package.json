{
  "name": "gif-tastic-dynamic",
  "version": "2.0.0",
  "private": true,
  "description": "GifTastic: a fast, accessible GIF finder with reaction suggestions, built on SvelteKit and Cloudflare Workers.",
  "author": "Paul Xu",
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "node scripts/prepare.mjs",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint": "oxlint --deny-warnings && oxfmt --check",
    "format": "oxfmt",
    "test": "bun test src",
    "e2e": "playwright test",
    "knip": "knip",
    "cf-typegen": "node scripts/typegen.mjs",
    "cf:deploy": "bun run build && wrangler deploy",
    "demo-clips": "bun scripts/make-demo-clips.mjs",
    "gifs": "bun scripts/make-gifs.mjs",
    "validate": "bun run lint && bun run typecheck && bun run test && bun run build && bun run e2e && bun run knip"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@sveltejs/adapter-cloudflare": "^8.0.1",
    "@sveltejs/kit": "^3.1.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/bun": "^1.4.4",
    "@types/node": "^22.20.5",
    "knip": "^6.43.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "svelte": "^5.57.3",
    "svelte-check": "^4.7.7",
    "typescript": "~6.0.3",
    "vite": "^8.3.5",
    "wrangler": "^4.154.0"
  },
  "engines": {
    "bun": ">=1.4",
    "node": ">=22.17"
  },
  "packageManager": "bun@1.4.4",
  "trustedDependencies": [
    "esbuild",
    "workerd"
  ]
}
